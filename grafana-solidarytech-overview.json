{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "title": "SolidaryTech - Visão Geral de Recursos",
  "description": "Dashboard de apresentação: uso de CPU e memória dos pods de produção (ngo-service, donation-service, volunteer-service)",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "timezone": "browser",
  "time": { "from": "now-1h", "to": "now" },
  "refresh": "30s",
  "panels": [
    {
      "id": 1,
      "title": "SolidaryTech — Recursos em Produção",
      "type": "text",
      "gridPos": { "h": 3, "w": 24, "x": 0, "y": 0 },
      "options": {
        "mode": "markdown",
        "content": "### Uso de CPU e Memória — ngo-service, donation-service, volunteer-service\nNamespace: `solidarytech` · Cluster: `solidarytech-production`"
      }
    },
    {
      "id": 2,
      "title": "Pods Ativos",
      "type": "stat",
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 3 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "count(count by (pod) (container_memory_working_set_bytes{namespace=\"solidarytech\", container!=\"\", container!=\"POD\"}))",
          "legendFormat": "Pods"
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": { "unit": "short", "color": { "mode": "thresholds" } },
        "overrides": []
      }
    },
    {
      "id": 3,
      "title": "CPU Total (m)",
      "type": "stat",
      "gridPos": { "h": 5, "w": 6, "x": 6, "y": 3 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "sum(rate(container_cpu_usage_seconds_total{namespace=\"solidarytech\", container!=\"\", container!=\"POD\"}[5m])) * 1000",
          "legendFormat": "CPU (millicores)"
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": { "unit": "short", "decimals": 1, "color": { "mode": "thresholds" } },
        "overrides": []
      }
    },
    {
      "id": 4,
      "title": "Memória Total (MB)",
      "type": "stat",
      "gridPos": { "h": 5, "w": 6, "x": 12, "y": 3 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "sum(container_memory_working_set_bytes{namespace=\"solidarytech\", container!=\"\", container!=\"POD\"}) / 1024 / 1024",
          "legendFormat": "Memória (MB)"
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": { "unit": "short", "decimals": 1, "color": { "mode": "thresholds" } },
        "overrides": []
      }
    },
    {
      "id": 5,
      "title": "Uptime do Cluster (nós prontos)",
      "type": "stat",
      "gridPos": { "h": 5, "w": 6, "x": 18, "y": 3 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "count(count by (node) (container_memory_working_set_bytes{namespace=\"solidarytech\"}))",
          "legendFormat": "Nós"
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": { "unit": "short", "color": { "mode": "thresholds" } },
        "overrides": []
      }
    },
    {
      "id": 6,
      "title": "CPU por Pod",
      "type": "timeseries",
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "sum(rate(container_cpu_usage_seconds_total{namespace=\"solidarytech\", container!=\"\", container!=\"POD\"}[5m])) by (pod) * 1000",
          "legendFormat": "{{pod}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 10 }
        },
        "overrides": []
      }
    },
    {
      "id": 7,
      "title": "Memória por Pod",
      "type": "timeseries",
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "sum(container_memory_working_set_bytes{namespace=\"solidarytech\", container!=\"\", container!=\"POD\"}) by (pod) / 1024 / 1024",
          "legendFormat": "{{pod}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "decmbytes",
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 10 }
        },
        "overrides": []
      }
    }
  ]
}
